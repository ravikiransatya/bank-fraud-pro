# Server Configuration
PORT=5000
JWT_SECRET=your_jwt_secret_key_change_in_production

# MongoDB Database URI
MONGO_URI=mongodb://localhost:27017/bank-fraud-db

# 2Factor.in Real SMS OTP Service
# Sign up at https://2factor.in and copy your API Key from the dashboard
TWOFACTOR_API_KEY=your_2factor_api_key_here

# Optional: 2Factor Approved DLT OTP Template Name (if using custom template)
# Leave empty to use 2Factor's default system AUTOGEN template
TWOFACTOR_OTP_TEMPLATE=

# Groq AI Service (for AI Assistant)
GROQ_API_KEY=your_groq_api_key_here
